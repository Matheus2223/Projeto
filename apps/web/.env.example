# Optional: activates real OpenAI responses on /ia (falls back to a local
# rule-based responder when unset).
OPENAI_API_KEY=

# Optional: base URL of the apps/api NestJS backend. When reachable, every
# page fetches live data from it; when unset/unreachable, each page falls
# back to the local deterministic mock generators automatically.
API_URL=http://localhost:3333/api/v1

# Credentials for the seeded demo user the server uses to authenticate
# server-to-server against the backend (see src/lib/api/auth.ts). Must match
# a user created by apps/api/prisma/seed.ts.
API_DEMO_EMAIL=equipe@provedor.com.br
API_DEMO_PASSWORD=trendhub123
